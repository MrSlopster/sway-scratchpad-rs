pkgname=sway-scratchpad-rs
pkgver=3.0.0
pkgrel=1
pkgdesc='Toggleable, positioned scratchpad windows for sway and i3 (Rust rewrite of sway-scratchpad)'
arch=('x86_64' 'aarch64')
url='https://github.com/emilyyyylime/sway-scratchpad'
license=('GPL-3.0-or-later')
depends=('glibc' 'libgcc')
makedepends=('cargo')
optdepends=('sway: window manager to drive'
            'i3-wm: window manager to drive')
provides=('sway-scratchpad')
conflicts=('sway-scratchpad' 'sway-scratchpad-git')
source=()
sha256sums=()

_srcroot="$startdir/../.."

pkgver() {
  sed -n 's/^version = "\(.*\)"$/\1/p' "$_srcroot/Cargo.toml" | head -n1
}

prepare() {
  cd "$_srcroot"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$_srcroot"
  export RUSTUP_TOOLCHAIN=stable
  # Keep build output inside makepkg's srcdir, not the working tree.
  export CARGO_TARGET_DIR="$srcdir/target"
  # makepkg strips and splits debug info itself.
  export CARGO_PROFILE_RELEASE_STRIP=false
  cargo build --frozen --release
}

check() {
  cd "$_srcroot"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release
}

package() {
  cd "$_srcroot"
  install -Dm755 "$srcdir/target/release/sway-scratchpad" -t "$pkgdir/usr/bin/"
  install -Dm644 README.md CHANGELOG -t "$pkgdir/usr/share/doc/$pkgname/"
}
